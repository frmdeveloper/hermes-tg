# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# 9router lokal vela1
AI_BASE_URL=http://127.0.0.1:20128/v1
# API key 9router (otomatis disalin dari ~/wa33/.env pas install)
AI_API_KEY=
# Model bawaan (id dari 9router; "chatbot" = combo)
DEFAULT_MODEL=chatbot
# Kosongkan = bot terbuka buat siapa aja. Isi ID Telegram (pisah koma) buat ngunci.
ALLOWED_IDS=
SYSTEM_PROMPT=Kamu Hermes, asisten AI pribadi. Jawab dalam Bahasa Indonesia yang santai tapi jelas, singkat padat kecuali diminta detail.
